{
  "name": "dotrino-passmanager",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Gestor de contraseñas de Dotrino: la bóveda que responde y las piezas que piden",
  "dotrino": {
    "platforms": [
      "pwa",
      "ios",
      "android"
    ]
  },
  "bin": {
    "dotrino-passmanager": "bin/passmanager.js"
  },
  "scripts": {
    "test": "cd lib && npm test",
    "serve": "node bin/passmanager.js serve",
    "test:e2e": "node --test test/*.test.mjs",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest",
    "test:web": "python3 -m http.server 8099 --directory web/test",
    "test:bench": "node extension/test/bench.e2e.mjs",
    "test:save-prompt": "node extension/test/save-prompt.e2e.mjs",
    "test:login": "node extension/test/login.e2e.mjs",
    "test:opaque": "node extension/test/opaque.e2e.mjs",
    "test:backup": "node extension/test/backup.e2e.mjs",
    "test:offers": "node --test extension/test/*.test.mjs",
    "test:field-button": "node extension/test/field-button.e2e.mjs",
    "test:generate": "node extension/test/generate.e2e.mjs",
    "test:replacements": "node extension/test/replacements.e2e.mjs",
    "test:labels": "node extension/test/labels.e2e.mjs",
    "test:approval-wait": "node extension/test/approval-wait.e2e.mjs",
    "test:manager": "node extension/test/manager.e2e.mjs",
    "test:accounts": "node extension/test/accounts.e2e.mjs",
    "test:autofill": "node extension/test/autofill.e2e.mjs",
    "store:shots": "node extension/store/screenshots.mjs",
    "test:profile": "node extension/test/profile.e2e.mjs",
    "test:share": "node extension/test/share.e2e.mjs",
    "test:convert": "node extension/test/convert.e2e.mjs"
  },
  "dependencies": {
    "@dotrino/identity": "0.117.2",
    "@dotrino/proxy-client": "0.36.1",
    "@dotrino/update": "0.7.0",
    "@dotrino/vault": "0.87.0"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
